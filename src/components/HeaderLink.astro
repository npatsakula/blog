---
import type { HTMLAttributes } from 'astro/types';
import { normalizeLocale } from '../i18n/ui';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const base = `${import.meta.env.BASE_URL}/`.replace(/\/+$/, '/');
// Locale of the current page — used to scope every internal nav link.
const locale = normalizeLocale(Astro.currentLocale);
// Resolve the href against base and the current locale, so e.g. `/about`
// becomes `/ru/about/`.
const resolvedHref = `${base}${locale}${href}`;
// Strip base + locale to compare against the route path for active state.
const pathname = Astro.url.pathname.replace(base, '/').replace(
	new RegExp(`^/${locale}/?`),
	'/',
);
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === '/' + (subpath?.[0] || '');
---

<a href={resolvedHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
