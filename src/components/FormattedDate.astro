---
interface Props {
	date: Date;
}

const { date } = Astro.props;
// Format in the page's locale ("26 августа 2026 г." on /ru/, "Aug 26, 2026" on /en/).
const locale = Astro.currentLocale === 'ru' ? 'ru-RU' : 'en-US';
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: locale === 'ru-RU' ? 'long' : 'short',
			day: 'numeric',
		})
	}
</time>
