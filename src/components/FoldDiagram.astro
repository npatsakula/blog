---
// The algebraic fold, without notation: during training every n-gram's
// 128-number embedding row is averaged over the text and then multiplied by
// the 128×30 head W; because averaging and multiplying by W commute, every
// row is multiplied by W once after training, and inference averages ready
// 30-number rows instead. Two lanes, same input and same output; the one-off
// multiplication is the vertical arrow between them, and the inference lane
// simply skips the "× W" step.
//
// Light only and solid fills, like the other diagrams on the site.

import { normalizeLocale } from '../i18n/ui';

interface Props {
	caption?: string;
}
const { caption } = Astro.props;
const en = normalizeLocale(Astro.currentLocale) === 'en';

const t = en
	? {
			train: 'training',
			infer: 'inference',
			ngrams: ['text n-grams', 'one row each'],
			embed: ['embedding row', '128 numbers'],
			mean: ['average', 'over the text'],
			head: ['× W', '128 → 30'],
			scores: ['30 scores', 'one per language'],
			folded: ['folded row', '30 numbers'],
			bridge: ['× W, once', 'after training'],
			skip: 'no × W any more',
			aria: 'Training averages 128-number embedding rows of the text and multiplies the average by the matrix W to get 30 language scores. Since averaging and multiplying by W can be swapped, every row is multiplied by W once after training, and inference only averages ready 30-number rows.',
		}
	: {
			train: 'обучение',
			infer: 'инференс',
			ngrams: ['n-граммы текста', 'по строке на каждую'],
			embed: ['строка эмбеддингов', '128 чисел'],
			mean: ['среднее', 'по всему тексту'],
			head: ['× W', '128 → 30'],
			scores: ['30 оценок', 'по одной на язык'],
			folded: ['готовая строка', '30 чисел'],
			bridge: ['× W, один раз', 'после обучения'],
			skip: 'умножать на W не нужно',
			aria: 'При обучении строки эмбеддингов текста по 128 чисел усредняются, а среднее умножается на матрицу W и даёт 30 оценок языков. Усреднение и умножение на W можно поменять местами, поэтому после обучения каждая строка один раз умножается на W, и на инференсе остаётся только усреднить готовые строки по 30 чисел.',
		};

// --- geometry --------------------------------------------------------------
const W = 960;
const boxW = 148;
const boxH = 56;
const left = 86; // room for the lane labels
const gap = (W - left - 16 - 5 * boxW) / 4;
const x = (i: number) => left + i * (boxW + gap);
const cx = (i: number) => x(i) + boxW / 2;
const trainY = 8;
const inferY = trainY + boxH + 72;
const H = inferY + boxH + 8;

// Training lane: all five steps. Inference lane: the "× W" slot is skipped by
// one longer arrow. The accent marks only what W touches.
const trainBoxes = [t.ngrams, t.embed, t.mean, t.head, t.scores];
const inferBoxes = [t.ngrams, t.folded, t.mean, null, t.scores];
const arrow = (from: number, to: number, y: number) => ({ x1: x(from) + boxW + 4, x2: x(to) - 4, y: y + boxH / 2 });
const trainArrows = [0, 1, 2, 3].map((i) => arrow(i, i + 1, trainY));
const inferArrows = [arrow(0, 1, inferY), arrow(1, 2, inferY), arrow(2, 4, inferY)];
const skip = inferArrows[2];
const bridgeMidY = (trainY + boxH + inferY) / 2;
---

<figure class="fold">
	<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={t.aria}>
		<defs>
			<marker id="fold-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="arrow-head" />
			</marker>
			<marker id="fold-arrow-accent" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
				<path d="M0 0 L10 5 L0 10 z" class="arrow-head accent" />
			</marker>
		</defs>

		<text class="lane" x={16} y={trainY + boxH / 2} dominant-baseline="central">{t.train}</text>
		<text class="lane" x={16} y={inferY + boxH / 2} dominant-baseline="central">{t.infer}</text>

		{trainBoxes.map((b, i) => (
			<g>
				<rect class={i === 3 ? 'box accent' : 'box'} x={x(i)} y={trainY} width={boxW} height={boxH} rx="8" />
				<text class="title" x={cx(i)} y={trainY + 23} text-anchor="middle">{b[0]}</text>
				<text class="detail" x={cx(i)} y={trainY + 41} text-anchor="middle">{b[1]}</text>
			</g>
		))}
		{trainArrows.map((a) => <line class="arrow" x1={a.x1} y1={a.y} x2={a.x2} y2={a.y} marker-end="url(#fold-arrow)" />)}

		{inferBoxes.map((b, i) =>
			b && (
				<g>
					<rect class={i === 1 ? 'box accent' : 'box'} x={x(i)} y={inferY} width={boxW} height={boxH} rx="8" />
					<text class="title" x={cx(i)} y={inferY + 23} text-anchor="middle">{b[0]}</text>
					<text class="detail" x={cx(i)} y={inferY + 41} text-anchor="middle">{b[1]}</text>
				</g>
			),
		)}
		{inferArrows.map((a) => <line class="arrow" x1={a.x1} y1={a.y} x2={a.x2} y2={a.y} marker-end="url(#fold-arrow)" />)}
		<text class="skip" x={(skip.x1 + skip.x2) / 2} y={skip.y - 9} text-anchor="middle">{t.skip}</text>

		{/* the fold: every embedding row meets W once, after training */}
		<line class="arrow accent" x1={cx(1)} y1={trainY + boxH + 4} x2={cx(1)} y2={inferY - 4} marker-end="url(#fold-arrow-accent)" />
		{t.bridge.map((line, i) => (
			<text class={i === 0 ? 'bridge-text strong' : 'bridge-text'} x={cx(1) + 12} y={bridgeMidY - 8 + i * 17} dominant-baseline="central">{line}</text>
		))}
	</svg>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.fold {
		margin: 1.5em 0;
	}
	.fold svg {
		width: 100%;
		height: auto;
		display: block;
	}
	.box {
		fill: color-mix(in srgb, rgb(var(--gray)) 6%, #fff);
		stroke: rgb(var(--gray));
		stroke-width: 1.5;
	}
	.box.accent {
		fill: color-mix(in srgb, var(--accent) 7%, #fff);
		stroke: var(--accent);
		stroke-width: 2;
	}
	.title {
		fill: rgb(var(--gray-dark));
		font-family: var(--font-atkinson);
		font-size: 13.5px;
		font-weight: 700;
	}
	.detail,
	.skip {
		fill: rgb(var(--gray-dark));
		font-family: var(--font-atkinson);
		font-size: 12px;
		opacity: 0.78;
	}
	.skip {
		font-style: italic;
	}
	.lane {
		fill: rgb(var(--gray));
		font-family: var(--font-atkinson);
		font-size: 13px;
		font-weight: 700;
	}
	.arrow {
		stroke: rgb(var(--gray));
		stroke-width: 1.5;
		fill: none;
	}
	.arrow.accent {
		stroke: var(--accent);
		stroke-width: 2;
	}
	.arrow-head {
		fill: rgb(var(--gray));
	}
	.arrow-head.accent {
		fill: var(--accent);
	}
	.bridge-text {
		fill: var(--accent);
		font-family: var(--font-atkinson);
		font-size: 13px;
	}
	.bridge-text.strong {
		font-weight: 700;
	}
	.fold figcaption {
		text-align: center;
		color: rgb(var(--gray));
		font-size: 0.85em;
		margin-top: 0.6em;
	}
</style>
