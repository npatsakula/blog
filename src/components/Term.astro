---
// An inline term with a short explanation: dotted underline in the text, the
// explanation pops up above it on hover, and on tap or keyboard focus (the
// span is focusable) so it also works on phones. For jargon the post keeps
// on purpose instead of explaining it in the sentence.
//
// The popup is display: none until shown, so it never widens the page.

interface Props {
	tip: string;
}
const { tip } = Astro.props;
---

<span class="term" tabindex="0"><slot /><span class="tip" role="tooltip">{tip}</span></span>

<style>
	.term {
		position: relative;
		text-decoration: underline dotted rgb(var(--gray));
		text-underline-offset: 0.2em;
		text-decoration-thickness: 1.5px;
		cursor: help;
	}
	.term:focus {
		outline: none;
	}
	.term:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 2px;
	}
	.tip {
		display: none;
		position: absolute;
		bottom: calc(100% + 8px);
		left: 50%;
		transform: translateX(-50%);
		width: max-content;
		max-width: min(22em, 80vw);
		padding: 0.5em 0.75em;
		border-radius: 6px;
		background: rgb(var(--gray-dark));
		color: #fff;
		font-size: 0.8em;
		font-style: normal;
		font-weight: 400;
		line-height: 1.4;
		text-align: left;
		white-space: normal;
		z-index: 10;
		box-shadow: 0 4px 16px rgba(var(--gray), 33%);
		pointer-events: none;
	}
	.term:hover .tip,
	.term:focus .tip {
		display: block;
	}
</style>
