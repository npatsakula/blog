---
// Root entry. With `prefixDefaultLocale: true` there is no unprefixed home
// page, so `/` redirects to the default locale (`/ru/`). `redirectToDefaultLocale`
// bakes this into a static meta-refresh redirect at build time.
import { defaultLocale } from '../i18n/ui';
const base = `${import.meta.env.BASE_URL}/`.replace(/\/+$/, '/');
return Astro.redirect(`${base}${defaultLocale}/`, 302);
---

<!doctype html>
<html lang={defaultLocale}>
	<head>
		<meta charset="utf-8" />
		<meta
			http-equiv="refresh"
			content={`0; url=${base}${defaultLocale}/`}
		/>
	</head>
	<body>
		<p>
			Redirecting to <a href={`${base}${defaultLocale}/`}>{defaultLocale}/</a>.
		</p>
	</body>
</html>
