---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';
import { getUI, locales, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const base = `${import.meta.env.BASE_URL}/`.replace(/\/+$/, '/');
const t = getUI(locale);
// Filter to this locale's posts (ids look like `ru/<slug>`).
const posts = (await getCollection('blog', ({ id }) =>
	id.startsWith(`${locale}/`),
)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead title={SITE_TITLE} description={t.siteDescription} />
		<style>
			main {
				width: 720px;
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			/* One row per post, newest first: title, date, description. The old
			   template blew the first post up into a centred hero card, which
			   only works with a hero image; without one it looked unrelated to
			   the half-width cards below it. */
			ul li {
				padding: 1.5rem 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			ul li:first-child {
				padding-top: 0;
			}
			ul li a {
				display: block;
				text-decoration: none;
			}
			ul li img {
				width: 100%;
				height: auto;
				margin-bottom: 0.75rem;
				border-radius: 12px;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				font-size: 1.75rem;
				line-height: 1.2;
				transition: color 0.2s ease;
			}
			.date {
				margin: 0.25rem 0 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.description {
				margin: 0.5rem 0 0;
				color: rgb(var(--gray-dark));
			}
			ul li a:hover .title {
				color: rgb(var(--accent));
			}
			@media (max-width: 720px) {
				main {
					width: auto;
				}
				.title {
					font-size: 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul>
					{
						posts.map((post) => {
							// Drop the leading `<locale>/` from the id for the URL slug.
							const slug = post.id.replace(/^[^/]+\//, '');
							return (
								<li>
									<a href={`${base}${locale}/blog/${slug}/`}>
										{post.data.heroImage && (
											<Image
												width={720}
												height={360}
												src={post.data.heroImage}
												alt=""
											/>
										)}
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
										<p class="description">{post.data.description}</p>
									</a>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
